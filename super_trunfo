
#include <stdio.h>

int main() {

// ================= CARTA 1 =================

unsigned long int populacao1;
int pontos1;
float pib1;
float area1;
float densidade1;
float pib_per_capita1;
char estado1[50];
char codigo1[50];
char nome1[50];
float super_poder1;

// ================= CARTA 2 =================

unsigned long int populacao2;
int pontos2;
float pib2;
float area2;
float densidade2;
float pib_per_capita2;
char estado2[50];
char codigo2[50];
char nome2[50];
float super_poder2;

printf("*** JOGO SUPER TRUNFO ***\n\n");

// ================= ENTRADA CARTA 1 =================

printf("Digite o estado da carta 1:\n");
scanf(" %[^\n]", estado1);

printf("Digite o codigo da carta 1:\n");
scanf(" %[^\n]", codigo1);

printf("Digite o nome da cidade 1:\n");
scanf(" %[^\n]", nome1);

printf("Digite a populacao:\n");
scanf("%lu", &populacao1);

printf("Digite o PIB:\n");
scanf("%f", &pib1);

printf("Quantidade de pontos turisticos:\n");
scanf("%d", &pontos1);

printf("Digite a area da cidade:\n");
scanf("%f", &area1);

// ===== Cálculos carta 1 =====

if (area1 != 0)
    densidade1 = (float)populacao1 / area1;
else
    densidade1 = 0;

if (populacao1 != 0)
    pib_per_capita1 = pib1 / populacao1;
else
    pib_per_capita1 = 0;

if (densidade1 != 0)
    super_poder1 = (float)populacao1 + area1 + pib1 + pontos1 + pib_per_capita1 + (1.0f / densidade1);
else
    super_poder1 = (float)populacao1 + area1 + pib1 + pontos1 + pib_per_capita1;


// ================= ENTRADA CARTA 2 =================

printf("\nDigite o estado da carta 2:\n");
scanf(" %[^\n]", estado2);

printf("Digite o codigo da carta 2:\n");
scanf(" %[^\n]", codigo2);

printf("Digite o nome da cidade 2:\n");
scanf(" %[^\n]", nome2);

printf("Digite a populacao:\n");
scanf("%lu", &populacao2);

printf("Digite o PIB:\n");
scanf("%f", &pib2);

printf("Quantidade de pontos turisticos:\n");
scanf("%d", &pontos2);

printf("Digite a area da cidade:\n");
scanf("%f", &area2);

// ===== Cálculos carta 2 =====

if (area2 != 0)
    densidade2 = (float)populacao2 / area2;
else
    densidade2 = 0;

if (populacao2 != 0)
    pib_per_capita2 = pib2 / populacao2;
else
    pib_per_capita2 = 0;

if (densidade2 != 0)
    super_poder2 = (float)populacao2 + area2 + pib2 + pontos2 + pib_per_capita2 + (1.0f / densidade2);
else
    super_poder2 = (float)populacao2 + area2 + pib2 + pontos2 + pib_per_capita2;


// ================= EXIBIÇÃO =================

printf("\n--- CARTA 1 ---\n");
printf("Estado: %s\n", estado1);
printf("Codigo: %s\n", codigo1);
printf("Cidade: %s\n", nome1);
printf("Populacao: %lu\n", populacao1);
printf("Area: %.2f km²\n", area1);
printf("PIB: %.2f\n", pib1);
printf("Pontos turisticos: %d\n", pontos1);
printf("Densidade: %.2f hab/km²\n", densidade1);
printf("PIB per capita: %.2f\n", pib_per_capita1);
printf("Super Poder: %.2f\n", super_poder1);

printf("\n--- CARTA 2 ---\n");
printf("Estado: %s\n", estado2);
printf("Codigo: %s\n", codigo2);
printf("Cidade: %s\n", nome2);
printf("Populacao: %lu\n", populacao2);
printf("Area: %.2f km²\n", area2);
printf("PIB: %.2f\n", pib2);
printf("Pontos turisticos: %d\n", pontos2);
printf("Densidade: %.2f hab/km²\n", densidade2);
printf("PIB per capita: %.2f\n", pib_per_capita2);
printf("Super Poder: %.2f\n", super_poder2);


// ================= COMPARAÇÃO =================

printf("\n*** COMPARACAO DE CARTAS ***\n\n");

if (populacao1 > populacao2)
    printf("Populacao: Carta 1 venceu!\n");
else
    printf("Populacao: Carta 2 venceu!\n");

if (area1 > area2)
    printf("Area: Carta 1 venceu!\n");
else
    printf("Area: Carta 2 venceu!\n");

if (pib1 > pib2)
    printf("PIB: Carta 1 venceu!\n");
else
    printf("PIB: Carta 2 venceu!\n");

if (pontos1 > pontos2)
    printf("Pontos Turisticos: Carta 1 venceu!\n");
else
    printf("Pontos Turisticos: Carta 2 venceu!\n");

// Densidade → menor vence
if (densidade1 < densidade2)
    printf("Densidade Populacional: Carta 1 venceu!\n");
else
    printf("Densidade Populacional: Carta 2 venceu!\n");

if (pib_per_capita1 > pib_per_capita2)
    printf("PIB per Capita: Carta 1 venceu!\n");
else
    printf("PIB per Capita: Carta 2 venceu!\n");

if (super_poder1 > super_poder2)
    printf("Super Poder: Carta 1 venceu!\n");
else
    printf("Super Poder: Carta 2 venceu!\n");

return 0;
}
